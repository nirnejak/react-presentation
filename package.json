{
  "name": "react-presentation",
  "version": "1.0.0",
  "description": "Use your React components as presentation slides",
  "keywords": [
    "nextjs",
    "oxfmt",
    "oxlint",
    "precommit",
    "react",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/nirnejak/react-presentation/issues"
  },
  "license": "MIT",
  "author": "Jitendra Nirnejak <jeetnirnejak@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirnejak/react-presentation"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "tsc --pretty --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "akar-icons": "^1.9.31",
    "motion": "^13.4.6",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,css}": "oxfmt"
  },
  "volta": {
    "node": "24.14.0"
  }
}
